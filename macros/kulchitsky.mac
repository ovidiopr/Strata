#
# macro file for Strata.cc
#
# 2.25 MeV e-, transmitted through 26.60 mg/cm2 Al
# L.Kulchitsky Phys.Rev. 61 (1941) page 254.
#
# Gaussian th1/e = 9.50 +- 0.40 deg
# proj. distr. fit: exp(-0.5*(th/th0)**2) ====> th0 = th1/e/sqrt(2)
#
/control/cout/ignoreThreadsExcept 0
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 1 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 98.5185 um
/strata/geometry/layerMaterial 0 Aluminium
#
/run/setCut 1 mm
#
/strata/physics/addPhysics local
#
#
/run/initialize
#
/strata/gun/setDefault
/gun/particle e-
/gun/energy 2.25 MeV
#
/analysis/setFileName kulchitsky
/analysis/h1/set 22 100 0. 25. deg #space angle
/analysis/h1/set 23 100 -25. +25. deg #projected angle
/analysis/h1/setAscii 22
/analysis/h1/setAscii 23
#
/run/beamOn 100000
