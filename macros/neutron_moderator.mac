#
# Macro file for  Strata.cc
# (can be run in batch, without graphic)
#
# Fast neutrons into a hydrogenous moderator
#
# 2 MeV neutrons, the fission average, into 20 cm of polyethylene.
#
# neutron_hp is the list to use for this: an EM list for the recoil protons,
# elastic scattering off nuclei that are bound rather than free, HP
# inelastic and capture, and the decay of what the captures activate.
#
/control/verbose 0
/run/verbose 0
#
/strata/geometry/setSizeYZ 1 m
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 20 cm
/strata/geometry/layerMaterial 0 G4_POLYETHYLENE
#
/strata/physics/addPhysics neutron_hp
/run/setCut 1 mm
#
/run/initialize
#
/gun/particle neutron
/gun/energy 2 MeV
/strata/gun/rndBeam 0 mm
#
# The neutrons that got through, and the ones that came back out of the
# face they went in at; a moderator this thick sends most of them back
/analysis/h1/set 34 200 0 2.5 MeV
/analysis/h1/set 54 200 0 2.5 MeV
#
# The neutral spectra beside them hold the gammas, which in polyethylene
# means the 2.223 MeV line of H(n,gamma)D: roughly half of what reaches
# either face
/analysis/h1/set 30 200 0 2.5 MeV
/analysis/h1/set 50 200 0 2.5 MeV
#
# Every scatter off a hydrogen nucleus can hand over the whole of the
# neutron's energy, and the recoil proton carries it off; this is the
# spectrum of those protons, and the energy deposited with them
/analysis/h1/set 11 200 0 2 MeV
/analysis/h1/set 10 200 0 2 MeV
/analysis/h1/set 13 200 1e-9 2 MeV log10

/run/printProgress 2000
/run/beamOn 10000
