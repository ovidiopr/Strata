#
# macro file for Strata.cc
#
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 20 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 20 cm
/strata/geometry/layerMaterial 0 G4_Al
#
/strata/physics/addPhysics standard_opt4
#
/run/setCut 1 um
#
/run/initialize
#
# Gamma rays at 200 MeV
/gun/particle gamma
/gun/energy 200 MeV
#
# Set 5 T magnetic field in the Z direction
/strata/BField/setValue 0 0 5 T
/strata/BField/update
#
# Save files with interactions
/strata/files/saveCascades true
/strata/files/setCascadesName pair_casc.txt
