#
# macro file for Strata.cc
#
# 1 TeV mu+, transmitted through 3 m of iron
# D.E. Groom, S.R. Klein, Eur. Phys. J. C 15 (2000) 163-173
#
/control/cout/ignoreThreadsExcept 0
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 3 m
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 3 m
/strata/geometry/layerMaterial 0 Iron
#
#/strata/physics/addPhysics standard_opt3
/strata/physics/addPhysics local
#
/run/setCut 1 mm
# 
/run/initialize
#
/strata/gun/setDefault
/gun/particle mu+ 
/gun/energy 1 TeV
#
/analysis/setFileName tramu
/analysis/h1/set 20 100 950 1000 GeV #energy at exit
/analysis/h1/setAscii 20
#
/strata/stack/killSecondaries
#
/run/printProgress 10000
#
/run/beamOn 100000
