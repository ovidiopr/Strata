#
# macro file for Strata.cc
#
# proton 175 GeV/c, transmitted through 8.004 mm Al
# G. Shen et al., Phys. Rev. D 20 (1979) 1584-1588
#
# data theta0 = (1.93+-0.39)*e-5 rad ???
# proj. distr. exp(-0.5*(th/th0)**2)
#
/control/cout/ignoreThreadsExcept 0
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 1 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 8.004 mm
/strata/geometry/layerMaterial 0 Aluminium
#
/run/setCut 1 mm
#
/run/initialize
#
/strata/gun/setDefault
/gun/particle proton
/gun/energy 174.664 GeV #momentum 175 GeV/c
#
/analysis/setFileName shen2
/analysis/h1/set 22 100 0.00 0.004 deg #space angle
/analysis/h1/setAscii 22
/analysis/h1/set 23 100 -0.004 +0.004 deg #projected angle
/analysis/h1/setAscii 23
#
/strata/stack/killSecondaries
#
/run/beamOn 100000
