#
# macro file for Strata.cc
#
# LPM and dielectric effect measurement:
# 25 GeV electrons through thin foils.
# P.L. Anthony et al., Phys. Rev. D 56 (1997) 1373-1390
# https://doi.org/10.1103/PhysRevD.56.1373
#     		    
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 10 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 5.30 mm
/strata/geometry/layerMaterial 0 Aluminium
#/strata/geometry/layerThickness 0 0.15 mm
#/strata/geometry/layerMaterial 0 Lead
#
/strata/physics/addPhysics standard_opt4
#
/run/setCut 5 um
/run/setCutForAGivenParticle gamma 1 mm
#
/run/initialize
#
/strata/gun/setDefault
/gun/particle e- 
/gun/energy 25 GeV
#
/analysis/setFileName anthony
/analysis/h1/set 30 80 1.e-4 1. GeV	#gamma energy at exit
/analysis/h1/setAscii 30
#
/run/beamOn 100000
