#
# macro file for Strata.cc
#
/control/cout/ignoreThreadsExcept 0
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 1 m
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 1 m
/strata/geometry/layerMaterial 0 StripperGas
#
/strata/physics/addPhysics standard_opt0
#/strata/physics/addPhysics livermore
#
/run/setCut 1 um
#
/run/initialize
#
#/strata/gun/setDefault
# Bromine 2- at 1 MeV
/gun/particle ion
/gun/ion 35 79
/strata/gun/charge -2
/gun/energy 100 MeV
#
/tracking/verbose 0
#
/strata/EField/setValue 5 0 0 megavolt/m
#
/run/beamOn 1000
#
/strata/files/savePrimaries true
/strata/files/setPrimariesName efield_prim.txt
/strata/files/saveCascades true
/strata/files/setCascadesName efield_casc.txt