# macro file for Strata.cc
#
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 10 mm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 3 mm
/strata/geometry/layerMaterial 0 Tungsten
#
#/strata/physics/addPhysics local
/strata/physics/addPhysics standard_opt3
#
/run/setCut 100 um
#
/run/initialize
#
#/process/em/fluo true
#
/strata/gun/setDefault
/gun/particle e- 
/gun/energy 6 MeV
# 
/analysis/setFileName gamma
/analysis/h1/set 12 200 0.01 10 MeV #gamma: energy at vertex
/analysis/h1/set 14 200 0.01 10 MeV log10 #gamma: energy at vertex (log10)
/analysis/h1/set 30 200 0 6 MeV	 #gamma: energy at exit
/analysis/h1/set 50 200 0 6 MeV	 #gamma: energy at back
#
/analysis/h1/setAscii 12
/analysis/h1/setAscii 14
/analysis/h1/setAscii 30
/analysis/h1/setAscii 50
#
/run/printProgress 50000
# 
/run/beamOn 500000
