#
# macro file for Strata.cc
#
# Back x-ray emission by 20 keV electrons in Silver.
# E. Acosta et al., Journal of Applied Physics 83 (1998) 6038-6049
# Fig. 4-5-6
# https://doi.org/10.1063/1.367473
#    		    
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 1 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 1 cm
/strata/geometry/layerMaterial 0 Silver
#
/strata/physics/addPhysics standard_opt4
#
/run/initialize
#
/strata/gun/setDefault
/gun/particle e- 
/gun/energy 20 keV
#
/analysis/setFileName acosta
/analysis/h1/set 50 40 0 20 keV	#energy at exit. (reflected, neutral)
/analysis/h1/setAscii 50
#
/run/setCut 1 um
#
/run/printProgress 100000
# 
/run/beamOn 5000000
