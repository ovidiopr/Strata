#
# Macro file for Strata.cc
# (can be run in batch, without graphic)
#
#
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 10 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 10 cm
/strata/geometry/layerMaterial 0 Water
#
/strata/physics/addPhysics local
##/strata/physics/addPhysics standard_opt3
#
/run/initialize
#
/gun/particle proton
/gun/energy 100 MeV
#
# step limit
#/run/setCut 0.5 um
/run/setCut 1 um
#/strata/stepMax 0.5 um
#
/analysis/setFileName proton
/analysis/h1/set 1 100 70 80 mm
/analysis/h1/set 3 100 70 80 mm
/analysis/h1/set 11 100 1 10 keV
/analysis/h1/set 12 100 1 10 keV
/analysis/h1/setAscii 1
/analysis/h1/setAscii 3
/analysis/h1/setAscii 11
/analysis/h1/setAscii 12
#
/run/printProgress 1000
#
/run/beamOn 10000
#
