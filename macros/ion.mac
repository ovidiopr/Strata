#
# macro file for Strata.cc
#
/control/cout/ignoreThreadsExcept 0
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 1 m
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 0.1 mm
/strata/geometry/layerMaterial 0 G4_Fe
#
/strata/physics/addPhysics standard_opt0
#
/run/setCut 1 km
#
/run/initialize
#
#/strata/gun/setDefault
/gun/particle ion
/gun/ion 6 12 
/gun/energy 1200 MeV
#
/tracking/verbose 0
#
/run/beamOn 1000