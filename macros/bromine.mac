#
# Macro file for  Strata.cc
# (can be run in batch, without graphic)
# It shows how to introduce simple voxels
#
#
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 10 um
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 10 um
/strata/geometry/layerMaterial 0 G4_SILICON_DIOXIDE # Silica
#/strata/geometry/layerMaterial 0 G4_SILICON_DIOXIDE 2.65 g/cm3 # Quartz
#
/strata/geometry/voxelNumber 5
/strata/geometry/voxelDefinition 0 4. 4. 4. nm
/strata/geometry/voxelDefinition 1 4. 4. 4. nm
/strata/geometry/voxelDefinition 2 4. 4. 4. nm
/strata/geometry/voxelDefinition 3 4. 4. 4. nm
/strata/geometry/voxelDefinition 4 4. 4. 4. nm
/strata/geometry/voxelPosition 0 -4. 0. 0. um
/strata/geometry/voxelPosition 1 -2.  0. 0. um
/strata/geometry/voxelPosition 2  0.  0. 0. um
/strata/geometry/voxelPosition 3  2.  0. 0. um
/strata/geometry/voxelPosition 4  4.  0. 0. um
#
/strata/physics/addPhysics standardNR
/strata/physics/addPhysics elastic
/strata/physics/addPhysics binary
/strata/physics/addPhysics binary_ion
#
/run/initialize
#
# Bromine 7+ at 40 MeV
/gun/particle ion
/gun/ion 35 79 7
/gun/energy 40 MeV
#
# beam size
/strata/gun/rndBeam 5 nm
#
# limit the step size
/strata/stepMax 10 nm
#
# save histograms in an ascii file
/analysis/setFileName bromine
/analysis/h1/set 1 100 0 10 um
/analysis/h1/set 2 100 0 10 um
/analysis/h1/set 3 100 0 10 um
/analysis/h1/setAscii 1
/analysis/h1/setAscii 2
/analysis/h1/setAscii 3
#
/run/printProgress 1000
#
/run/beamOn 20000
