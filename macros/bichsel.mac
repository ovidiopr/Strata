#
# macro file for Strata.cc
#
# 0.766 MeV protons, transmitted through 1.37 mg/cm2 Al
# H. Bichsel, Phys. Rev. 112 (1958) 182-185
# https://doi.org/10.1103/PhysRev.112.182
#
# proj. angle distr. exp(-(th/th0)**2)  th0 = 4.44+- 0.20 deg
#
/control/cout/ignoreThreadsExcept 0
/control/verbose 2
/run/verbose 2
#
/strata/geometry/setSizeYZ 1 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 5.0741 um
/strata/geometry/layerMaterial 0 Aluminium
#
/run/setCut 1 mm
#
/run/initialize
#
/strata/gun/setDefault
/gun/particle proton
/gun/energy 766 keV
#
/analysis/setFileName bichsel
/analysis/h1/set 22 100  0  9 deg #space angle
/analysis/h1/set 23 100 -9 +9 deg #projected angle
/analysis/h1/setAscii 22
/analysis/h1/setAscii 23
#
/strata/stack/killSecondaries
#
/run/beamOn 100000
