#
# Macro file for  Strata.cc
# (can be run in batch, without graphic)
#
/control/verbose 2
/run/verbose 2
/tracking/verbose 0
#
/strata/geometry/setSizeYZ 20 cm
#
/strata/geometry/layerNumber 1
/strata/geometry/layerThickness 0 20 cm
/strata/geometry/layerMaterial 0 G4_WATER
#
/strata/geometry/voxelNumber 4
/strata/geometry/voxelDefinition 0 2. 2. 2. mm
/strata/geometry/voxelDefinition 1 2. 2. 2. mm
/strata/geometry/voxelDefinition 2 2. 2. 2. mm
/strata/geometry/voxelDefinition 3 2. 2. 2. mm
/strata/geometry/voxelPosition 0 -9.9 0. 0. mm
/strata/geometry/voxelPosition 1 -5.  0. 0. mm
/strata/geometry/voxelPosition 2  0.  0. 0. mm
/strata/geometry/voxelPosition 3  5.  0. 0. mm
#
#/strata/physics/addPhysics standard_opt3
#/strata/physics/addPhysics ionGasModels
/strata/physics/addPhysics hadron_therapy
#
/run/initialize
#
/gun/particle ion
/gun/ion 6 12 6
/gun/energy 2.4 GeV
#
# step limit
/run/setCut 0.5 mm
#
/run/printProgress 100
#
/analysis/setFileName hadron_therapy
/analysis/h1/set 2 100 80 90 mm
/analysis/h1/set 3 100 80 90 mm
#
/run/beamOn 10000
#
