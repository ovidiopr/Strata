  object EditorActions: TActionList
    Left = 48
    Top = 560
    object actNewMacro: TAction
      Category = 'File'
      Caption = '&New macro'
      Hint = 'New|New macro'
      ImageIndex = 0
      OnExecute = actNewMacroExecute
    end
    object actSaveMacro: TAction
      Category = 'File'
      Caption = '&Save macro'
      Hint = 'Save|Save macro'
      ImageIndex = 2
      OnExecute = actSaveMacroExecute
    end
    object actSaveMacroAs: TFileSaveAs
      Category = 'File'
      Caption = 'Save macro &as ...'
      Dialog.Title = 'Save Geant4 macro'
      Dialog.DefaultExt = '.mac'
      Dialog.Filter = 'Geant4 macro (*.mac)|*.mac|All files|*'
      Hint = 'Save As|Save macro as'
      ImageIndex = 3
      BeforeExecute = actSaveMacroAsBeforeExecute
      OnAccept = actSaveMacroAsAccept
    end
    object actEdRun: TAction
      Category = 'Geant4'
      Caption = 'Run'
      Hint = 'Run|Run the macro in a new engine'
      ImageIndex = 7
      OnExecute = actEdRunExecute
    end
    object actEdStep: TAction
      Category = 'Geant4'
      Caption = 'Step'
      Hint = 'Step|Send the next command of the macro and stop'
      ImageIndex = 39
      ShortCut = 119
      OnExecute = actEdStepExecute
    end
    object actEdRunToCursor: TAction
      Category = 'Geant4'
      Caption = 'Run to cursor'
      Hint = 'Run to cursor|Send the macro up to the line the cursor is on, and stop there'
      ImageIndex = 40
      ShortCut = 115
      OnExecute = actEdRunToCursorExecute
    end
    object actEdExportHistogram: TAction
