<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="10" transverseSizeUnit="um">
    <layer unit="um" index="0" material="Water" thickness="10"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking stepMax="0.5" stepMaxUnit="nm" killSecondaries="0"/>
  <beam angle="0" energy="400" events="10000" radius="0" particle="alpha" energyUnit="MeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="local"/>
  <spectra>
    <spectrum id="2" fcn="" max="85" min="75" bins="100" unit="nm"/>
    <spectrum id="3" fcn="" max="85" min="75" bins="100" unit="nm"/>
  </spectra>
  <commands stage="run">/run/printProgress 1000
</commands>
  <output folder="" fileName="alpha"/>
</strata-configuration>
