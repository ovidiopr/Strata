<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="3" transverseSizeUnit="m">
    <layer unit="m" index="0" material="Iron" thickness="3"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking cut="1" cutUnit="mm" killSecondaries="1"/>
  <beam angle="0" energy="1" events="100000" radius="0" particle="mu+" energyUnit="TeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="local"/>
  <spectra>
    <spectrum id="20" fcn="" max="1000" min="950" bins="100" unit="GeV"/>
  </spectra>
  <commands stage="preinit">/control/cout/ignoreThreadsExcept 0
</commands>
  <commands stage="beam">/strata/gun/setDefault
</commands>
  <commands stage="run">/analysis/h1/setAscii 20
/run/printProgress 10000
</commands>
  <output folder="" fileName="tramu"/>
</strata-configuration>
