<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="60" transverseSizeUnit="um">
    <layer unit="um" index="0" material="Silver" thickness="50"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking stepMax="50" stepMaxUnit="nm" killSecondaries="0"/>
  <beam angle="0" energy="35" events="100000" radius="0" particle="e-" energyUnit="keV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="standardNR"/>
  <spectra>
    <spectrum id="40" fcn="" max="40" min="0" bins="40" unit="keV"/>
  </spectra>
  <commands stage="preinit">/control/cout/ignoreThreadsExcept 0
</commands>
  <commands stage="beam">/strata/gun/setDefault
</commands>
  <commands stage="run">/analysis/h1/setAscii 40
/run/printProgress 10000
</commands>
  <output folder="" fileName="tavora"/>
</strata-configuration>
