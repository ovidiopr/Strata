<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="1" transverseSizeUnit="m">
    <layer unit="m" index="0" material="StripperGas" thickness="1"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="yes" primaries="yes" cascadesFile="efield_casc.txt" primariesFile="efield_prim.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <efield ex="5" ey="0" ez="0" unit="megavolt/m" minStep="1" stepper="4" minStepUnit="mm"/>
  <tracking cut="1" cutUnit="um" killSecondaries="0"/>
  <beam angle="0" energy="100" events="1000" radius="0" particle="ion" energyUnit="MeV">
    <ion a="79" z="35" charge="-1"/>
  </beam>
  <physics list="standard_opt0"/>
  <spectra/>
  <commands stage="preinit">/control/cout/ignoreThreadsExcept 0
</commands>
  <commands stage="run">/strata/gun/charge -2
/tracking/verbose 0
</commands>
  <output folder="" fileName="strata"/>
</strata-configuration>
