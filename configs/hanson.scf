<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="1" transverseSizeUnit="cm">
    <layer unit="um" index="0" material="Gold" thickness="19.296"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking cut="1.12" cutUnit="um" cut_gamma="13" cutUnit_gamma="um" killSecondaries="0"/>
  <beam angle="0" energy="15.7" events="1000000" radius="0" particle="e-" energyUnit="MeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="local"/>
  <spectra>
    <spectrum id="22" fcn="" max="30" min="0" bins="120" unit="deg"/>
  </spectra>
  <commands stage="preinit">/control/cout/ignoreThreadsExcept 0
</commands>
  <commands stage="beam">/strata/gun/setDefault
</commands>
  <commands stage="run">/analysis/h1/setAscii 22
/run/printProgress 100000
</commands>
  <output folder="" fileName="hanson_19um-local"/>
</strata-configuration>
