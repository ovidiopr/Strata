<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="1" transverseSizeUnit="m">
    <layer unit="m" index="0" material="Iron" thickness="1"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking cut="1" cutUnit="mm" killSecondaries="1"/>
  <beam angle="0" energy="100" events="40000" radius="0" particle="mu+" energyUnit="GeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="standard_opt0"/>
  <spectra>
    <spectrum id="24" fcn="" max="5" min="-5" bins="100" unit="mm"/>
    <spectrum id="25" fcn="" max="10" min="0" bins="100" unit="mm"/>
  </spectra>
  <commands stage="preinit">/control/cout/ignoreThreadsExcept 0
</commands>
  <commands stage="beam">/strata/gun/setDefault
</commands>
  <commands stage="run">/analysis/h1/setAscii 24
/analysis/h1/setAscii 25
/run/printProgress 4000
</commands>
  <output folder="" fileName="mumsc"/>
</strata-configuration>
