<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="1" transverseSizeUnit="um">
    <layer unit="um" index="0" material="G4_Fe" thickness="1"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <damage enabled="yes"/>
  <beam angle="0" energy="1" events="2000" radius="0" particle="ion" energyUnit="MeV">
    <ion a="56" z="26" charge="-1"/>
  </beam>
  <physics list="standardNR"/>
  <spectra>
    <spectrum id="4" fcn="" max="1" min="0" bins="100" unit="um"/>
    <spectrum id="5" fcn="" max="1" min="0" bins="100" unit="um"/>
    <spectrum id="6" fcn="" max="100" min="0" bins="200" unit="keV"/>
    <spectrum id="2" fcn="" max="1" min="0" bins="100" unit="um"/>
  </spectra>
  <commands stage="preinit">/strata/damage/print
</commands>
  <commands stage="run">/run/printProgress 500
</commands>
  <output folder="" fileName="strata"/>
</strata-configuration>
