<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="1" transverseSizeUnit="m">
    <layer unit="cm" index="0" material="G4_POLYETHYLENE" thickness="20"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking cut="1" cutUnit="mm" killSecondaries="0"/>
  <beam angle="0" energy="2" events="10000" radius="0" particle="neutron" energyUnit="MeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="neutron_hp"/>
  <spectra>
    <spectrum id="34" fcn="" max="2.5" min="0" bins="200" unit="MeV"/>
    <spectrum id="54" fcn="" max="2.5" min="0" bins="200" unit="MeV"/>
    <spectrum id="30" fcn="" max="2.5" min="0" bins="200" unit="MeV"/>
    <spectrum id="50" fcn="" max="2.5" min="0" bins="200" unit="MeV"/>
    <spectrum id="11" fcn="" max="2" min="0" bins="200" unit="MeV"/>
    <spectrum id="10" fcn="" max="2" min="0" bins="200" unit="MeV"/>
    <spectrum id="13" fcn="log10" max="2" min="1E-9" bins="200" unit="MeV"/>
  </spectra>
  <commands stage="run">/run/printProgress 2000
</commands>
  <output folder="" fileName="strata"/>
</strata-configuration>
