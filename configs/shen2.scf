<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="1" transverseSizeUnit="cm">
    <layer unit="mm" index="0" material="Aluminium" thickness="8.004"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking cut="1" cutUnit="mm" killSecondaries="1"/>
  <beam angle="0" energy="174.664" events="100000" radius="0" particle="proton" energyUnit="GeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="standardNR"/>
  <spectra>
    <spectrum id="22" fcn="" max="0.004" min="0" bins="100" unit="deg"/>
    <spectrum id="23" fcn="" max="0.004" min="-0.004" bins="100" unit="deg"/>
  </spectra>
  <commands stage="preinit">/control/cout/ignoreThreadsExcept 0
</commands>
  <commands stage="beam">/strata/gun/setDefault
</commands>
  <commands stage="run">/analysis/h1/setAscii 22
/analysis/h1/setAscii 23
</commands>
  <output folder="" fileName="shen2"/>
</strata-configuration>
