<?xml version="1.0" encoding="utf-8"?>
<strata-configuration version="1">
  <engine threads="2"/>
  <geometry temperature="293.15" worldMaterial="G4_Galactic" transverseSize="10" transverseSizeUnit="cm">
    <layer unit="mm" index="0" material="Aluminium" thickness="5.3"/>
  </geometry>
  <materials/>
  <voxels/>
  <tracks cascades="no" primaries="no" cascadesFile="cascades.txt" primariesFile="primaries.txt"/>
  <random seed1="0" seed2="0" engine="ranecu" seeding="perRun"/>
  <tracking cut="5" cutUnit="um" cut_gamma="1" cutUnit_gamma="mm" killSecondaries="0"/>
  <beam angle="0" energy="25" events="100000" radius="0" particle="e-" energyUnit="GeV">
    <ion a="28" z="14" charge="-1"/>
  </beam>
  <physics list="standard_opt4"/>
  <spectra>
    <spectrum id="30" fcn="" max="1" min="0.0001" bins="80" unit="GeV"/>
  </spectra>
  <commands stage="beam">/strata/gun/setDefault
</commands>
  <commands stage="run">/analysis/h1/setAscii 30
</commands>
  <output folder="" fileName="anthony"/>
</strata-configuration>
